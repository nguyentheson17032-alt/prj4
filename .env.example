# Database Configuration - PostgreSQL
DB_PASSWORD=your_database_password

# JWT Configuration (Secret ngẫu nhiên bảo mật 64 ký tự)
JWT_SECRET=your_very_long_jwt_secret_key_at_least_32_chars_or_64_hex

# Flyway Migration Configuration (Bật tự động sửa lệch checksum ở môi trường dev)
FLYWAY_REPAIR_ON_MIGRATE=true

# SMTP config for Gmail
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# VNPay config
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_RETURN_URL=http://localhost:8080/api/payments/vnpay-return

# Firebase Cloud Messaging
FCM_SERVER_KEY=
